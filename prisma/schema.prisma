// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  active
  inactive
  blacklist
}

enum PriceTier {
  tier1
  tier2
  tier3
  tier4
  tier5
}

enum SaleMode {
  retail
  tax
}

enum SalePaymentType {
  cash
  transfer
  account
  mixed
}

enum PurchaseOrderStatus {
  draft
  ordered
  closed
  cancelled
}

enum StockMovementType {
  sale_out
  purchase_in
  adjust_in
  adjust_out
  transfer_in
  transfer_out
  return_in
  return_out
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        Member[]
  products       Product[]
  sales          Sale[]
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
}

model Member {
  id               String       @id @default(cuid())
  memberCode       String       @unique
  fullName         String
  address          String?
  taxId            String?
  contactPerson    String?
  email            String?
  phone            String?
  fax              String?
  salesStaffId     String?
  creditLimitBaht  Float        @default(0)
  creditTermDays   Int          @default(0)
  creditTermMonths Int          @default(0)
  payAtMonthEnd    Boolean      @default(false)
  cutOffDayOfMonth Int?
  defaultPriceTier PriceTier    @default(tier1)
  markupPercent    Float        @default(0)
  priceStartDate   String?
  priceEndDate     String?
  itemTierOverrides Json        @default("[]")
  notes            String?
  memberType       String       @default("general")
  status           MemberStatus @default(active)
  pointsBalance    Float        @default(0)
  arBalance        Float        @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  sales Sale[]

  @@index([fullName])
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  brand       String?
  category    String
  subCategory String?
  location    String?
  stockMode   String?
  costPrice   Float    @default(0)
  minStock    Float    @default(0)
  maxStock    Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  saleLines          SaleLine[]
  purchaseOrderLines PurchaseOrderLine[]
  stockMovements     StockMovement[]
  priceLevels        ProductPriceLevel[]
  returnLines        SaleReturnLine[]

  @@index([name])
  @@index([category])
}

model ProductPriceLevel {
  id         String   @id @default(cuid())
  levelCode  String
  levelLabel String
  unitLabel  String   @default("ชิ้น")
  unitIndex  Int      @default(0)
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, levelCode, unitIndex])
}

model CreditNote {
  id             String     @id @default(cuid())
  creditNoteNo   String     @unique
  originalSaleId String
  originalSale   Sale       @relation(fields: [originalSaleId], references: [id], onDelete: Restrict)
  returnId       String     @unique
  return         SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  creditNoteDate DateTime   @default(now())
  beforeVat      Float      @default(0)
  vatAmount      Float      @default(0)
  totalAmount    Float      @default(0)
  createdAt      DateTime   @default(now())

  @@index([originalSaleId])
}

model Expense {
  id            String   @id @default(cuid())
  expenseDate   DateTime @db.Date
  category      String
  amount        Float    @default(0)
  note          String?
  payee         String?
  paymentMethod String   @default("cash")
  branchId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expenseDate])
  @@index([category])
}

/** แฟ้มข้อมูลสินค้า (มาสเตอร์) — payload = ProductMasterDetail แบบ JSON */
model ProductMasterRow {
  id        String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

/** แฟ้มผู้จำหน่าย — payload = SupplierProfile แบบ JSON */
model SupplierRow {
  id        String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

/** ใบสั่งซื้อ — payload = PurchaseOrder แบบ JSON */
model PurchaseOrderRow {
  id        String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

/** สแนปช็อตโปรโมชั่น — id = 'buyQty' | 'percentOff' | 'secondPiece' */
model PromotionsSnapshot {
  id        String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

model Sale {
  id             String          @id @default(cuid())
  billNo         String          @unique
  taxInvoiceNo   String?
  mode           SaleMode
  paymentType    SalePaymentType
  docDate        DateTime
  subtotal       Float
  billDiscount   Float           @default(0)
  beforeVat      Float           @default(0)
  vatAmount      Float           @default(0)
  roundingAdjust Float           @default(0)
  grandTotal     Float
  remark         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  /// Prisma Studio: ข้อความจาก createdAt — DB เติมด้วย trigger (ไม่มี suffix Z); ไม่ต้องส่งตอน create
  createdAtBangkokDisplay String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  lines       SaleLine[]
  returns     SaleReturn[]
  creditNotes CreditNote[]

  voidedAt   DateTime?
  voidReason String?

  @@index([docDate])
  @@index([paymentType])
  @@index([branchId, docDate])
}

model SaleReturn {
  id             String   @id @default(cuid())
  returnNo       String   @unique
  originalSaleId String
  originalSale   Sale     @relation(fields: [originalSaleId], references: [id], onDelete: Restrict)
  returnDate     DateTime @default(now())
  reason         String?
  refundMethod   String   @default("cash")
  totalRefund    Float    @default(0)
  createdAt      DateTime @default(now())

  lines      SaleReturnLine[]
  creditNote CreditNote?

  @@index([originalSaleId])
}

model SaleReturnLine {
  id                 String     @id @default(cuid())
  returnId           String
  return             SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId          String
  product            Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  originalSaleLineId String?
  productName        String
  qty                Float
  unitPrice          Float
  lineTotal          Float

  @@index([returnId])
}

/** ลำดับเลขบิล POS (retail) / ใบกำกับ (tax) — คีย์ = ตามแอป (เครื่อง+สาขา+พ.ศ. 2 หลัก+เดือน) */
model PosBillSequenceCounter {
  id        String   @id
  lastSeq   Int
  updatedAt DateTime @updatedAt
}

model SaleLine {
  id              String   @id @default(cuid())
  qty             Float
  unitLabel       String
  unitIndex       Int      @default(0)
  unitPrice       Float
  discount        Float    @default(0)
  lineTotal       Float
  costAtSale      Float    @default(0)
  priceLevelLabel String?
  priceLevelIndex Int?
  priceTagLabel   String?
  createdAt       DateTime @default(now())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNo         String              @unique
  status       PurchaseOrderStatus @default(draft)
  supplierName String
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  note         String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  lines PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id               String   @id @default(cuid())
  orderedQty       Float
  receivedQtyTotal Float    @default(0)
  unitCost         Float
  lineTotal        Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model StockMovement {
  id         String            @id @default(cuid())
  movementAt DateTime          @default(now())
  type       StockMovementType
  qtyDelta   Float
  unitCost   Float?
  refType    String?
  refId      String?
  note       String?
  createdAt  DateTime          @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}
