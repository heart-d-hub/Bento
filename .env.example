# คัดลอกเป็นไฟล์ ".env" ที่รากโปรเจกต์ (ข้าง package.json)
# แอป Tauri โหลดตอนรัน — ใช้กับสมาชิก / การขาย POS ใน PostgreSQL
#
# สร้างฐานข้อมูลแล้วรัน migration ตามที่ทีมใช้ (เช่น npx prisma migrate deploy)

# แนะนำให้ใส่ options เพื่อให้ Prisma Studio / migrate ใช้เวลาไทยตรงกับแอป (คอลัมน์ timestamp แบบไม่มี timezone)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bento?schema=public&options=-c%20TimeZone=Asia/Bangkok"
